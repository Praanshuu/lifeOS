DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key

# --- AI Configuration ---

# Primary: OpenRouter (NVIDIA Nemotron 3 Super 120B)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Alternative key name supported for backwards compatibility:
# OPENROUTER_NEMOTRON_3_SUPER_API_KEY=sk-or-v1-...

# Fallback: Groq Cloud
# Get your free API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: Local Ollama
# Run `ollama serve` in a terminal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:latest